<Project>

  <!-- Runs AFTER each project's own PropertyGroup, so $(IsPackable) reflects the per-project override
       (Directory.Build.props imports first, when IsPackable is still the default false). Packs the shared
       README into the root of every packable NuGet package to satisfy <PackageReadmeFile>. The LICENSE is
       declared via <PackageLicenseExpression> (SPDX), which needs no packed file. -->
  <ItemGroup Condition="'$(IsPackable)' == 'true'">
    <None Include="$(MSBuildThisFileDirectory)README.md" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

  <!-- SExpressionSharp's packaging metadata lives here rather than in its own .csproj so that this
       change and the parallel parser refactor touch disjoint files. Only <TargetFramework> has to be
       set in the .csproj itself: MSBuild infers TargetFrameworkIdentifier/Version before
       Directory.Build.targets is imported, so a TFM set here is ignored (measured).
       Move this block into SExpressionSharp.csproj once the refactor has landed. -->
  <PropertyGroup Condition="'$(MSBuildProjectName)' == 'SExpressionSharp'">
    <IsPackable>true</IsPackable>
    <PackageId>SExpressionSharp</PackageId>
    <Description>A small, dependency-free S-expression parser and writer for .NET. Reads and writes the
Lisp-style parenthesised syntax used by KiCad files, Guile/Scheme configuration and similar formats,
into a plain object tree you can walk, query and serialise back out.</Description>
    <PackageTags>s-expression;sexpr;sexp;parser;writer;lisp;serialization</PackageTags>
  </PropertyGroup>

</Project>
