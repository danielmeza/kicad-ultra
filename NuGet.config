<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <!-- `local-packages` is git-ignored and normally empty. scripts/use-local-libs.sh fills it with
         locally packed SExpressions/KiCadSharp builds stamped with distinct versions, which you then
         select with -p:SExpressionsVersion=... / -p:KiCadSharpVersion=.... With the folder empty (or
         the default versions requested) restore resolves from nuget.org as usual. -->
    <add key="local-packages" value="local-packages" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
