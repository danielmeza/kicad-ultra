<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:UltraLibrarianImporter.UI.ViewModels"
        xmlns:models="using:UltraLibrarianImporter.UI.Services.Interfaces"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:webview="clr-namespace:WebViewControl;assembly=WebViewControl.Avalonia"
        mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="800"
        x:Class="UltraLibrarianImporter.UI.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="KiCad Component Explorer &amp; Importer"
        Width="1400" Height="820"
        MinWidth="1200" MinHeight="750"
        WindowStartupLocation="CenterScreen">

  <Window.Resources>
    <vm:HexToBrushConverter x:Key="HexToBrushConverter" />
    <vm:ImportTypeDisplayConverter x:Key="ImportTypeDisplayConverter" />
  </Window.Resources>

  <Grid RowDefinitions="Auto,*,Auto" ColumnDefinitions="*,320">
    <!-- Top Action Bar -->
    <StackPanel Grid.Row="0" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="10,8" Spacing="8">
      <Button Content="Settings" Command="{Binding OpenSettingsCommand}" Padding="10,5"/>
      <Button Content="Import Component" Command="{Binding ImportComponentCommand}" IsEnabled="{Binding CanImport}" Padding="10,5"/>
      <Button Content="Open Downloads Folder" Command="{Binding OpenDownloadsFolderCommand}" Padding="10,5"/>
      <Button Content="About" Command="{Binding ShowAboutCommand}" Padding="10,5"/>
      <Button Command="{Binding BackToExplorerCommand}" 
              IsVisible="{Binding IsOnBrowserTab}" 
              ToolTip.Tip="Return to Part Explorer search results"
              Padding="10,5"
              FontWeight="SemiBold"
              Cursor="Hand">
        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
          <TextBlock Text="◀" FontSize="11" VerticalAlignment="Center"/>
          <TextBlock Text="Back to Search" VerticalAlignment="Center"/>
        </StackPanel>
      </Button>

      <TextBlock Text="Import Filter:" VerticalAlignment="Center" Margin="15,0,0,0" FontWeight="SemiBold"/>
      <ComboBox Width="180" 
                ItemsSource="{Binding ImportTypes}" 
                SelectedItem="{Binding SelectedImportType}">
        <ComboBox.ItemTemplate>
          <DataTemplate>
            <TextBlock Text="{Binding Converter={StaticResource ImportTypeDisplayConverter}}" />
          </DataTemplate>
        </ComboBox.ItemTemplate>
      </ComboBox>
    </StackPanel>

    <!-- Main Content Area: Tabs for Part Explorer vs Web Browser -->
    <TabControl Grid.Row="1" Grid.Column="0" SelectedIndex="{Binding SelectedTabIndex}" Margin="10,0,5,10">
      
      <!-- TAB 1: Unified Multi-Provider Part Explorer -->
      <TabItem Header="🔍 Part Explorer (Aggregated Search)">
        <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,*,Auto" Margin="10">
          <!-- Search Header -->
          <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,5,0,8">
            <TextBox Grid.Column="0" 
                     Text="{Binding SearchQuery}" 
                     Watermark="Search parts across all providers by MPN, keyword or value (e.g. STM32F401, NE555, ESP32, 10k 0805)..."
                     VerticalContentAlignment="Center"
                     Height="38"
                     FontSize="14"
                     Margin="0,0,10,0"/>
            <Button Grid.Column="1" 
                    Command="{Binding SearchPartsCommand}" 
                    Height="38"
                    Padding="18,0"
                    VerticalContentAlignment="Center"
                    HorizontalContentAlignment="Center"
                    CornerRadius="4"
                    Cursor="Hand">
              <TextBlock Text="Search All Providers" 
                         FontWeight="Bold" 
                         FontSize="13" 
                         VerticalAlignment="Center" 
                         HorizontalAlignment="Center"
                         Margin="0,3,0,0"/>
            </Button>
          </Grid>

          <!-- Quick Filter/Sort Bar -->
          <Grid Grid.Row="1" ColumnDefinitions="Auto,Auto,Auto,Auto,*" Margin="0,0,0,8" VerticalAlignment="Center">
            <TextBlock Grid.Column="0" Text="Sort by:" VerticalAlignment="Center" FontSize="12" Opacity="0.75" Margin="0,0,8,0"/>
            
            <Button Grid.Column="1" 
                    Command="{Binding SortCommand}" 
                    CommandParameter="Stock" 
                    Padding="10,4" 
                    Margin="0,0,6,0"
                    FontSize="11" 
                    CornerRadius="3"
                    Cursor="Hand">
              <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                <TextBlock Text="📦 Stock" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,1,0,0"/>
                <TextBlock Text="{Binding StockSortIndicator}" FontWeight="ExtraBold" Foreground="{DynamicResource SystemControlHighlightAccentBrush}" VerticalAlignment="Center"/>
              </StackPanel>
            </Button>

            <Button Grid.Column="2" 
                    Command="{Binding SortCommand}" 
                    CommandParameter="Price" 
                    Padding="10,4" 
                    Margin="0,0,6,0"
                    FontSize="11" 
                    CornerRadius="3"
                    Cursor="Hand">
              <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                <TextBlock Text="💲 Price" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,1,0,0"/>
                <TextBlock Text="{Binding PriceSortIndicator}" FontWeight="ExtraBold" Foreground="{DynamicResource SystemControlHighlightAccentBrush}" VerticalAlignment="Center"/>
              </StackPanel>
            </Button>

            <Button Grid.Column="3" 
                    Command="{Binding SortCommand}" 
                    CommandParameter="CAD" 
                    Padding="10,4" 
                    Margin="0,0,6,0"
                    FontSize="11" 
                    CornerRadius="3"
                    Cursor="Hand">
              <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                <TextBlock Text="📐 CAD Assets" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,1,0,0"/>
                <TextBlock Text="{Binding CadSortIndicator}" FontWeight="ExtraBold" Foreground="{DynamicResource SystemControlHighlightAccentBrush}" VerticalAlignment="Center"/>
              </StackPanel>
            </Button>

            <TextBlock Grid.Column="4" Text="{Binding SortStatusSummary}" VerticalAlignment="Center" HorizontalAlignment="Right" FontSize="11" Opacity="0.65" Margin="10,0,0,0"/>
          </Grid>

          <!-- Search Progress Bar -->
          <ProgressBar Grid.Row="2" 
                       IsIndeterminate="True" 
                       IsVisible="{Binding IsSearching}" 
                       Height="3" 
                       Margin="0,0,0,8"/>

          <!-- EasyEDA / LCSC import needs the user-installed easyeda2kicad (#76). Shown only once a
               check has found it missing, with the command that installs it on this system. -->
          <Border Grid.Row="3"
                  IsVisible="{Binding IsEasyEda2KiCadMissing}"
                  Background="#20F57C00"
                  BorderBrush="#F57C00"
                  BorderThickness="1"
                  CornerRadius="4"
                  Padding="10,8"
                  Margin="0,0,0,8">
            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto">
              <TextBlock Grid.Row="0" Grid.Column="0"
                         Text="EasyEDA / LCSC import is unavailable: easyeda2kicad is not installed. It is an optional third-party tool (AGPL-3.0) that you install yourself; it is not part of this application. Install it with:"
                         TextWrapping="Wrap"
                         FontWeight="SemiBold"
                         FontSize="12"/>
              <SelectableTextBlock Grid.Row="1" Grid.Column="0"
                                   Text="{Binding EasyEda2KiCadInstallCommand}"
                                   FontFamily="Consolas, Cascadia Code, Courier New, monospace"
                                   FontSize="12"
                                   Margin="0,6,0,0"/>
              <TextBlock Grid.Row="2" Grid.Column="0"
                         Text="{Binding EasyEda2KiCadInstallNote}"
                         TextWrapping="Wrap"
                         FontSize="11"
                         Opacity="0.75"
                         Margin="0,4,0,0"/>
              <StackPanel Grid.Row="0" Grid.RowSpan="3" Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Margin="10,0,0,0">
                <Button Content="Check again" Command="{Binding CheckEasyEda2KiCadCommand}" Padding="10,4" FontSize="11"/>
                <Button Content="Settings..." Command="{Binding OpenSettingsCommand}" Padding="10,4" FontSize="11"/>
              </StackPanel>
            </Grid>
          </Border>

          <!-- Which JLCPCB source EasyEDA / LCSC search uses (#51, #52): the unofficial endpoint can break
               without notice, so say so, link to JLCPCB's API guide and point at the credentials. Blocks nothing. -->
          <Border Grid.Row="4"
                  IsVisible="{Binding IsJlcpcbNoticeVisible}"
                  Background="#201976D2"
                  BorderBrush="#1976D2"
                  BorderThickness="1"
                  CornerRadius="4"
                  Padding="10,8"
                  Margin="0,0,0,8">
            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto">
              <TextBlock Grid.Row="0" Grid.Column="0"
                         Text="{Binding JlcpcbNoticeTitle}"
                         TextWrapping="Wrap"
                         FontWeight="SemiBold"
                         FontSize="12"/>
              <TextBlock Grid.Row="1" Grid.Column="0"
                         Text="{Binding JlcpcbNoticeText}"
                         TextWrapping="Wrap"
                         FontSize="11"
                         Margin="0,4,0,0"/>
              <HyperlinkButton Grid.Row="2" Grid.Column="0"
                               NavigateUri="{Binding JlcpcbApiGuideUri}"
                               Padding="0"
                               FontSize="11"
                               Margin="0,4,0,0">
                <TextBlock Text="{Binding JlcpcbApiGuideUri, StringFormat='JLCPCB API access guide: {0}'}" TextWrapping="Wrap"/>
              </HyperlinkButton>
              <StackPanel Grid.Row="0" Grid.RowSpan="3" Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Margin="10,0,0,0">
                <Button Content="Settings..." Command="{Binding OpenSettingsCommand}" Padding="10,4" FontSize="11"/>
                <Button Content="Hide"
                        Command="{Binding HideJlcpcbNoticeCommand}"
                        ToolTip.Tip="Hide this notice until the app restarts or the JLCPCB API settings change"
                        Padding="10,4"
                        FontSize="11"/>
              </StackPanel>
            </Grid>
          </Border>

          <!-- Results List / Table -->
          <Border Grid.Row="5" BorderThickness="1" BorderBrush="{DynamicResource SystemControlHighlightBaseMediumLowBrush}" CornerRadius="4">
            <Grid RowDefinitions="Auto,*">
              <!-- Table Header -->
              <Border Grid.Row="0" Background="{DynamicResource SystemControlBackgroundBaseLowBrush}" Padding="10,8">
                <Grid ColumnDefinitions="140,160,130,105,105,120,*">
                  <TextBlock Grid.Column="0" Text="Provider" FontWeight="Bold" VerticalAlignment="Center"/>
                  <TextBlock Grid.Column="1" Text="Part Number" FontWeight="Bold" VerticalAlignment="Center"/>
                  <TextBlock Grid.Column="2" Text="Manufacturer" FontWeight="Bold" VerticalAlignment="Center"/>

                  <!-- Stock Header (Clickable Sort) -->
                  <Button Grid.Column="3" 
                          Command="{Binding SortCommand}" 
                          CommandParameter="Stock"
                          Background="Transparent" 
                          BorderThickness="0" 
                          Padding="0" 
                          Cursor="Hand"
                          HorizontalAlignment="Left">
                    <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                      <TextBlock Text="Stock" FontWeight="Bold" VerticalAlignment="Center"/>
                      <TextBlock Text="{Binding StockSortIndicator}" FontWeight="ExtraBold" Foreground="{DynamicResource SystemControlHighlightAccentBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                  </Button>

                  <!-- Best Price Header (Clickable Sort) -->
                  <Button Grid.Column="4" 
                          Command="{Binding SortCommand}" 
                          CommandParameter="Price"
                          Background="Transparent" 
                          BorderThickness="0" 
                          Padding="0" 
                          Cursor="Hand"
                          HorizontalAlignment="Left">
                    <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                      <TextBlock Text="Best Price" FontWeight="Bold" VerticalAlignment="Center"/>
                      <TextBlock Text="{Binding PriceSortIndicator}" FontWeight="ExtraBold" Foreground="{DynamicResource SystemControlHighlightAccentBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                  </Button>

                  <!-- CAD Assets Header (Clickable Sort) -->
                  <Button Grid.Column="5" 
                          Command="{Binding SortCommand}" 
                          CommandParameter="CAD"
                          Background="Transparent" 
                          BorderThickness="0" 
                          Padding="0" 
                          Cursor="Hand"
                          HorizontalAlignment="Left">
                    <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                      <TextBlock Text="CAD Assets" FontWeight="Bold" VerticalAlignment="Center"/>
                      <TextBlock Text="{Binding CadSortIndicator}" FontWeight="ExtraBold" Foreground="{DynamicResource SystemControlHighlightAccentBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                  </Button>

                  <TextBlock Grid.Column="6" Text="Action" FontWeight="Bold" VerticalAlignment="Center"/>
                </Grid>
              </Border>

              <!-- Results Items -->
              <ListBox Grid.Row="1" ItemsSource="{Binding SearchResults}" SelectedItem="{Binding SelectedSearchResult}">
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="models:PartSearchResult">
                    <Grid ColumnDefinitions="140,160,130,105,105,120,*" RowDefinitions="Auto,Auto" Margin="0,4">
                      <!-- Provider Badge -->
                      <Border Grid.Column="0" 
                              Background="{Binding ProviderColor, Converter={StaticResource HexToBrushConverter}}" 
                              CornerRadius="3" 
                              Padding="6,2" 
                              HorizontalAlignment="Left"
                              VerticalAlignment="Center">
                        <TextBlock Text="{Binding ProviderName}" FontSize="11" FontWeight="SemiBold" Foreground="White"/>
                      </Border>

                      <!-- MPN, and the LCSC code when the provider reported one -->
                      <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding PartNumber}" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding LcscPartNumber, StringFormat='LCSC {0}'}"
                                   IsVisible="{Binding LcscPartNumber, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                   FontSize="10"
                                   Opacity="0.7"/>
                      </StackPanel>

                      <!-- Manufacturer -->
                      <TextBlock Grid.Column="2" Text="{Binding Manufacturer}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>

                      <!-- Stock -->
                      <TextBlock Grid.Column="3" 
                                 Text="{Binding Stock, StringFormat='{}{0:N0}', TargetNullValue='-'}" 
                                 VerticalAlignment="Center"/>

                      <!-- Price -->
                      <TextBlock Grid.Column="4" 
                                 Text="{Binding BestPrice, StringFormat='${0:F2}', TargetNullValue='-'}" 
                                 VerticalAlignment="Center"/>

                      <!-- CAD Flags -->
                      <StackPanel Grid.Column="5" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                        <Border Background="#2E7D32" CornerRadius="2" Padding="4,1" IsVisible="{Binding HasSymbol}">
                          <TextBlock Text="Sym" FontSize="10" Foreground="White" FontWeight="Bold"/>
                        </Border>
                        <Border Background="#1565C0" CornerRadius="2" Padding="4,1" IsVisible="{Binding HasFootprint}">
                          <TextBlock Text="FP" FontSize="10" Foreground="White" FontWeight="Bold"/>
                        </Border>
                        <Border Background="#6A1B9A" CornerRadius="2" Padding="4,1" IsVisible="{Binding Has3DModel}">
                          <TextBlock Text="3D" FontSize="10" Foreground="White" FontWeight="Bold"/>
                        </Border>
                      </StackPanel>

                      <!-- Actions: the import routes this result has (#47), and open the part's page. A
                           disabled route says why in its tip; a result with no route at all says so. -->
                      <WrapPanel Grid.Column="6" ItemSpacing="6" LineSpacing="4" HorizontalAlignment="Left" VerticalAlignment="Center">
                        <!-- Results with an LCSC code, through easyeda2kicad (#76) -->
                        <Button Content="Import"
                                Command="{Binding ((vm:MainViewModel)DataContext).ImportPartCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="{Binding}"
                                IsVisible="{Binding LcscPartNumber, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                ToolTip.Tip="{Binding ((vm:MainViewModel)DataContext).ImportPartToolTip, RelativeSource={RelativeSource AncestorType=Window}}"
                                ToolTip.ShowOnDisabled="True"
                                Padding="10,4"
                                VerticalContentAlignment="Center"
                                FontSize="11"/>
                        <!-- Results with a manufacturer part number, through the Web Browser tab's Ultra Librarian download -->
                        <Button Content="Find on Ultra Librarian"
                                Command="{Binding ((vm:MainViewModel)DataContext).FindOnUltraLibrarianCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="{Binding}"
                                IsVisible="{Binding PartNumber, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                ToolTip.Tip="{Binding ((vm:MainViewModel)DataContext).FindOnUltraLibrarianToolTip, RelativeSource={RelativeSource AncestorType=Window}}"
                                ToolTip.ShowOnDisabled="True"
                                Padding="10,4"
                                VerticalContentAlignment="Center"
                                FontSize="11"/>
                        <TextBlock Text="No import route"
                                   ToolTip.Tip="This result has neither an LCSC code nor a manufacturer part number to look up."
                                   FontSize="11"
                                   Opacity="0.6"
                                   VerticalAlignment="Center">
                          <TextBlock.IsVisible>
                            <MultiBinding Converter="{x:Static BoolConverters.And}">
                              <Binding Path="LcscPartNumber" Converter="{x:Static StringConverters.IsNullOrEmpty}"/>
                              <Binding Path="PartNumber" Converter="{x:Static StringConverters.IsNullOrEmpty}"/>
                            </MultiBinding>
                          </TextBlock.IsVisible>
                        </TextBlock>
                        <Button Content="Open Page"
                                Command="{Binding ((vm:MainViewModel)DataContext).OpenInWebBrowserCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="{Binding}"
                                ToolTip.Tip="Open the part's page in the Web Browser tab"
                                Padding="10,4"
                                VerticalContentAlignment="Center"
                                FontSize="11"/>
                      </WrapPanel>

                      <!-- Data source, when it is not the provider itself -->
                      <TextBlock Grid.Row="1"
                                 Grid.Column="1"
                                 Grid.ColumnSpan="6"
                                 Text="{Binding Attribution}"
                                 ToolTip.Tip="{Binding Attribution}"
                                 IsVisible="{Binding Attribution, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                 FontSize="10"
                                 Opacity="0.6"
                                 Margin="0,2,0,0"
                                 TextTrimming="CharacterEllipsis"/>
                    </Grid>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>

              <!-- Empty state message -->
              <StackPanel Grid.Row="1" 
                          IsVisible="{Binding !SearchResults.Count}" 
                          HorizontalAlignment="Center" 
                          VerticalAlignment="Center" 
                          Spacing="6" 
                          Margin="20">
                <TextBlock Text="No component search results" 
                           HorizontalAlignment="Center" 
                           Opacity="0.6" 
                           FontSize="13" 
                           FontWeight="SemiBold"/>
                <TextBlock Text="Search parts across providers by MPN or keyword using the search bar above." 
                           HorizontalAlignment="Center" 
                           Opacity="0.4" 
                           FontSize="11"/>
              </StackPanel>
            </Grid>
          </Border>

          <!-- Enabled providers the search above does not reach, so that their absence says why -->
          <TextBlock Grid.Row="6"
                     Text="{Binding BrowserOnlyProviders}"
                     IsVisible="{Binding BrowserOnlyProviders, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                     TextWrapping="Wrap"
                     FontSize="11"
                     Opacity="0.65"
                     Margin="0,6,0,0"/>
        </Grid>
      </TabItem>

      <!-- TAB 2: Embedded Web Browser & Direct Download Interceptor -->
      <TabItem Header="🌐 Web Browser (Interactive)">
        <Grid RowDefinitions="Auto,*" Margin="5">
          <!-- Web Browser Navigation Header -->
          <Grid Grid.Row="0" ColumnDefinitions="Auto,Auto,Auto,Auto,Auto,*" Margin="0,0,0,8" VerticalAlignment="Center">
            <!-- Back to Part Explorer Button -->
            <Button Grid.Column="0" 
                    Command="{Binding BackToExplorerCommand}" 
                    ToolTip.Tip="Back to Part Explorer search results"
                    Padding="10,5" 
                    Margin="0,0,8,0"
                    FontWeight="SemiBold"
                    Cursor="Hand">
              <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                <TextBlock Text="◀" FontSize="11" VerticalAlignment="Center"/>
                <TextBlock Text="Back to Search" VerticalAlignment="Center"/>
              </StackPanel>
            </Button>

            <!-- Web Browser History Navigation Buttons -->
            <Button Grid.Column="1" 
                    Command="{Binding BrowserBackCommand}" 
                    ToolTip.Tip="Go back to previous page"
                    Padding="8,5" 
                    Margin="0,0,4,0"
                    Cursor="Hand">
              <TextBlock Text="◀" FontWeight="Bold" FontSize="11" VerticalAlignment="Center"/>
            </Button>
            <Button Grid.Column="2" 
                    Command="{Binding BrowserForwardCommand}" 
                    ToolTip.Tip="Go forward to next page"
                    Padding="8,5" 
                    Margin="0,0,4,0"
                    Cursor="Hand">
              <TextBlock Text="▶" FontWeight="Bold" FontSize="11" VerticalAlignment="Center"/>
            </Button>
            <Button Grid.Column="3" 
                    Command="{Binding BrowserReloadCommand}" 
                    ToolTip.Tip="Reload current page"
                    Padding="8,5" 
                    Margin="0,0,10,0"
                    Cursor="Hand">
              <TextBlock Text="🔄" FontSize="11" VerticalAlignment="Center"/>
            </Button>

            <!-- Provider Platform Selector -->
            <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
              <TextBlock Text="Provider Platform:" VerticalAlignment="Center" FontWeight="SemiBold"/>
              <ComboBox Width="200"
                        ItemsSource="{Binding AvailableProviders}"
                        SelectedItem="{Binding SelectedProvider}">
                <ComboBox.ItemTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding DisplayName}" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
            </StackPanel>

            <!-- Provider Search URL -->
            <TextBlock Grid.Column="5" 
                       Text="{Binding SelectedProvider.SearchUrl}" 
                       VerticalAlignment="Center" 
                       Foreground="Gray" 
                       FontSize="11" 
                       TextTrimming="CharacterEllipsis"
                       Margin="10,0,0,0"/>
          </Grid>

          <!-- WebView Container -->
          <Border Grid.Row="1" BorderThickness="1" BorderBrush="Gray">
            <Panel Name="WebViewContainer" Background="White">
              <webview:WebView Name="OSWebView" AllowDeveloperTools="True" Address="{Binding WebviewUrl}" Focusable="True" IsVisible="{Binding WebViewLoaded}" />
              <TextBlock Text="Loading component provider portal..."
                         VerticalAlignment="Center"
                         HorizontalAlignment="Center"
                         IsVisible="{Binding !WebViewLoaded}"/>
            </Panel>
          </Border>
        </Grid>
      </TabItem>
    </TabControl>

    <!-- Right Panel (Import Activity Log) -->
    <Grid Grid.Row="1" Grid.Column="1" RowDefinitions="Auto,*" Margin="5,0,10,10">
      <TextBlock Grid.Row="0" Text="Import &amp; System Log" FontWeight="Bold" Margin="0,0,0,6"/>
      <Border Grid.Row="1" BorderThickness="1" BorderBrush="{DynamicResource SystemControlHighlightBaseMediumLowBrush}" CornerRadius="4">
        <ListBox ItemsSource="{Binding ImportMessages}" Background="{DynamicResource SystemControlBackgroundAltHighBrush}" />
      </Border>
    </Grid>

    <!-- Status Bar -->
    <Grid Grid.Row="2" Grid.ColumnSpan="2" ColumnDefinitions="*,Auto,Auto" Background="{DynamicResource SystemControlBackgroundBaseLowBrush}">
      <TextBlock Grid.Column="0" Text="{Binding StatusMessage}" VerticalAlignment="Center" Margin="10,4"/>
      <Button Grid.Column="1" Content="Cancel Import" Command="{Binding ImportPartCancelCommand}" IsVisible="{Binding IsImportingPart}"
              Padding="8,2" FontSize="11" VerticalAlignment="Center"/>
      <ProgressBar Grid.Column="2" Width="200" Height="14" IsVisible="{Binding IsProgressVisible}"
                   IsIndeterminate="{Binding IsProgressIndeterminate}"
                   Value="{Binding ProgressValue}" Margin="10,0,10,0"/>
    </Grid>
  </Grid>
</Window>
