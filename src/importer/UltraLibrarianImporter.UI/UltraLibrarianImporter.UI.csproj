<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
    <AvaloniaXaml Remove="ViewModels\NewFolder\**" />
    <Compile Remove="ViewModels\NewFolder\**" />
    <EmbeddedResource Remove="ViewModels\NewFolder\**" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="nlog.config" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="nlog.config">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
    <!-- Avalonia 12's replacement for Avalonia.Diagnostics (App.Initialize attaches it in Debug).
         The condition keeps it out of Release builds, as it did for Avalonia.Diagnostics. -->
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
    <PackageReference Include="CefGlue.Avalonia" />
    <PackageReference Include="CefGlue.Common" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Lemon.Hosting.AvaloniauiDesktop" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="NLog.Extensions.Logging" />
    <PackageReference Include="ReactiveUI.Avalonia" />
    <PackageReference Include="System.Threading.RateLimiting" />
  </ItemGroup>

  <ItemGroup>
    <!-- KiCadSharp moved to its own repository (danielmeza/kicad-sharp) and ships from nuget.org.
         Its version lives in Directory.Packages.props, which resolves it from $(KiCadSharpVersion)
         so the command-line override still works; see README, "Developing against local library
         sources", for the local folder feed that builds this against an unreleased checkout. -->
    <PackageReference Include="KiCadSharp" />
  </ItemGroup>
</Project>
