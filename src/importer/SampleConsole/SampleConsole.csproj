<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="9.0.4" />
  </ItemGroup>

  <ItemGroup>
    <!-- Both libraries moved to their own repositories and ship from nuget.org:
         danielmeza/kicad-sharp and danielmeza/sexpressions. -->
    <PackageReference Include="KiCadSharp" Version="$(KiCadSharpVersion)" />
    <PackageReference Include="SExpressions" Version="$(SExpressionsVersion)" />
  </ItemGroup>

</Project>
