<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--
      Multi-targeted on purpose. The tests need net10.0 (this repo's other projects are still on
      net9.0 and a net10.0-only library breaks `dotnet restore` on the solution), and nothing here
      uses an API newer than .NET 8, so both frameworks build from one source set.
    -->
    <TargetFrameworks>net9.0;net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
