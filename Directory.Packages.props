<Project>

  <!-- Central Package Management: every PackageReference in the repository takes its version from
       this file, and the csproj files carry only the package id. -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup Label="Avalonia">
    <!-- Avalonia 12 (#67). Avalonia.Diagnostics has no 12.x: AvaloniaUI.DiagnosticsSupport is its
         replacement, used in Debug builds only (see the csproj). Avalonia.Xaml.Interactions has no
         12.x either, and nothing here used it, so it was dropped rather than renamed to
         Xaml.Behaviors.Avalonia. -->
    <PackageVersion Include="Avalonia" Version="12.1.2" />
    <PackageVersion Include="Avalonia.Desktop" Version="12.1.2" />
    <PackageVersion Include="Avalonia.Fonts.Inter" Version="12.1.2" />
    <PackageVersion Include="Avalonia.Themes.Fluent" Version="12.1.2" />
    <PackageVersion Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3" />
  </ItemGroup>

  <ItemGroup Label="Embedded browser">
    <!-- The CEF browser the import flow runs inside, used directly: WebViewControl-Avalonia, which
         used to wrap it, has no Avalonia 12 build and its WebView constructor calls an Avalonia API
         that 12 removed. CefGlue.Avalonia for Avalonia 12 is not published yet either; its version
         comes from Directory.Build.props, which explains where the package comes from until it is.
         CefGlue.Common is pinned here because that locally packed CefGlue.Avalonia declares a
         dependency on a prerelease CefGlue.Common that does not exist: the pull request does not
         change CefGlue.Common, so the published build of the same source is the one to use. -->
    <PackageVersion Include="CefGlue.Avalonia" Version="$(CefGlueAvaloniaVersion)" />
    <PackageVersion Include="CefGlue.Common" Version="120.6099.211" />
  </ItemGroup>

  <ItemGroup Label="Application">
    <PackageVersion Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <!-- Built against Avalonia 11 and unmaintained since. Every method in it still JIT-compiles
         against Avalonia 12.1.2 (checked for #67), so it stays until it gives trouble. -->
    <PackageVersion Include="Lemon.Hosting.AvaloniauiDesktop" Version="1.1.1" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="10.0.12" />
    <PackageVersion Include="NLog.Extensions.Logging" Version="6.2.0" />
    <!-- The BCL token-bucket and partitioned rate limiters (#55). dotnet/runtime ships this assembly
         in the ASP.NET Core shared framework only, not in Microsoft.NETCore.App, so a desktop app
         takes it as a package. No dependencies on net8.0+; keep it on the same 10.0.x patch as the
         Microsoft.Extensions packages above. -->
    <PackageVersion Include="System.Threading.RateLimiting" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup Label="Split-out libraries">
    <!-- These two keep taking their version from the properties in Directory.Build.props so that
         scripts/use-local-libs.sh can still select a locally packed build with
         -p:SExpressionsVersion=... / -p:KiCadSharpVersion=... on the command line. -->
    <PackageVersion Include="KiCadSharp" Version="$(KiCadSharpVersion)" />
    <PackageVersion Include="SExpressions" Version="$(SExpressionsVersion)" />
  </ItemGroup>

</Project>
