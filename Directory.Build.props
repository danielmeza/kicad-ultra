<Project>

  <!-- Shared build settings for every project in the repository. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- Security-audit findings (vulnerable packages) must fail the build/CI, not just warn. -->
    <NuGetAuditMode>all</NuGetAuditMode>
    <!-- Without this the IDE* code-style rules in .editorconfig are reported by the IDE and by
         `dotnet format` but never by `dotnet build`, so CI cannot see them. With it they are
         ordinary build diagnostics, which TreatWarningsAsErrors above then promotes to errors. -->
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <!-- IDE0005 (remove unnecessary usings) is only reported during a build when the compiler is
         also producing a documentation file: https://github.com/dotnet/roslyn/issues/41640.
         CS1591 is suppressed with it - the doc file exists to unlock the analyzer, and nothing here
         ships as a documented public API, so demanding an XML comment on every public member would
         be noise that TreatWarningsAsErrors turns into a build break. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <!-- Nothing in this repository is a NuGet package any more. The two libraries and the CLI that
         used to be packed here now live in danielmeza/sexpressions and danielmeza/kicad-sharp and
         are consumed from nuget.org. What is left is the Avalonia importer and the KiCad plugin. -->
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <!-- The identity every binary carries in its Windows version resource, and the one place it is
       written. Before this, nothing set it and every build shipped as `1.0.0.0` under the assembly
       name - the SDK's defaults - whatever the release was tagged.

       Three consumers have to agree on these strings, and they are checked against each other:
         * `dotnet publish -p:Version=` in .github/workflows/release.yml, which passes the tag;
         * the packTitle, packAuthors and packVersion arguments of `vpk pack` in the same file.
           Velopack stamps its installer's own version resource from them, so packTitle must read
           exactly like $(Product) and packAuthors like $(Company), or the installer and the
           application it installs claim to be two different products;
         * SignPath Foundation, which requires that signed binaries carry this metadata and that a
           signing request be rejected when they do not: "Set all product name attributes to your
           project's name. Set all product version attributes to the same value in each build."
           (https://signpath.org/terms.html). docs/signpath-application.md holds the artifact
           configuration that enforces it.

       $(Version) is the only one that moves. The SDK derives AssemblyVersion, FileVersion and
       InformationalVersion from it, so passing `-p:Version=0.1.0` is enough; the fallback below
       marks a build that did not come from a tag, and is deliberately not a plausible release
       number. -->
  <PropertyGroup>
    <Product>KiCad Ultra</Product>
    <Company>Daniel Meza</Company>
    <Version Condition="'$(Version)' == ''">0.0.0-dev</Version>
    <!-- Off, and the reason is not cosmetic. The SDK has bundled SourceLink since .NET 8, so in a
         git checkout it appends the commit to the informational version, and the informational
         version is what a Windows PE file reports as ProductVersion: measured, a build of 0.1.0
         came out as `0.1.0+2507afb0909dd1333fa4eb5774bb28a0d297a376`. Velopack's installer would
         still say `0.1.0`, so the two halves of one release would disagree, and SignPath's
         product-version restriction - which compares the string - would reject every signing
         request. Nothing else is lost: the PDB still carries SourceLink's source mapping, and the
         commit is recoverable from the tag. -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>

  <!-- Versions of the split-out libraries this repository consumes. Override either on the command
       line to build against a locally packed build; see README, "Developing against local library
       sources". -->
  <PropertyGroup>
    <SExpressionsVersion Condition="'$(SExpressionsVersion)' == ''">0.2.0</SExpressionsVersion>
    <KiCadSharpVersion Condition="'$(KiCadSharpVersion)' == ''">0.4.0</KiCadSharpVersion>
  </PropertyGroup>

</Project>
