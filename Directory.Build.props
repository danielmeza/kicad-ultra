<Project>

  <!-- Shared build settings for every project in the repository. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- Security-audit findings (vulnerable packages) must fail the build/CI, not just warn. -->
    <NuGetAuditMode>all</NuGetAuditMode>
    <!-- Nothing in this repository is a NuGet package any more. The two libraries and the CLI that
         used to be packed here now live in danielmeza/sexpressions and danielmeza/kicad-sharp and
         are consumed from nuget.org. What is left is the Avalonia importer and the KiCad plugin. -->
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <!-- Versions of the split-out libraries this repository consumes. Override either on the command
       line to build against a locally packed build; see README, "Developing against local library
       sources". -->
  <PropertyGroup>
    <SExpressionsVersion Condition="'$(SExpressionsVersion)' == ''">0.1.0</SExpressionsVersion>
    <KiCadSharpVersion Condition="'$(KiCadSharpVersion)' == ''">0.1.0</KiCadSharpVersion>
  </PropertyGroup>

</Project>
